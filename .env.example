# Gmail address used for SMTP authentication and the default sender.
SMTP_USER=your-gmail-address@gmail.com
# Generate this in Google Account > Security > 2-Step Verification > App passwords.
SMTP_APP_PASSWORD=your-16-character-google-app-password
# Set to the exact public origin, without a trailing path (e.g. https://huqapani.pk).
SITE_ORIGIN=https://your-store-domain.example
# Optional: must be an address Gmail permits this account to send as.
# ORDER_FROM_EMAIL=your-gmail-address@gmail.com
